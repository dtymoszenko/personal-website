---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import SocialLinks from '../components/SocialLinks.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import CredentialPreview from '../components/CredentialPreview.astro';
import Footer from '../components/Footer.astro';
import { projects } from '../data/projects';
import { credentials } from '../data/credentials';
import headshot from '../assets/headshot.jpg';
---

<BaseLayout
  title="David Tymoszenko"
  description="David Tymoszenko — Full Stack Software Engineer. Projects and portfolio."
>
  <Navigation />

  <main>
    <section class="hero">
      <div class="hero-content">
        <div class="hero-text">
          <h1>David Tymoszenko</h1>
          <p class="hero-description">
            Full-stack software engineer at LCS, working on{' '}
            <a href="https://www.rentmanager.com" target="_blank" rel="noopener noreferrer">Rent Manager</a>.
            I love building projects around the things I'm passionate about.
          </p>
          <SocialLinks />
        </div>
        <div class="hero-avatar">
          <Image
            src={headshot}
            alt="David Tymoszenko"
            width={360}
            height={360}
            loading="eager"
          />
        </div>
      </div>
    </section>

    <section id="projects" class="projects">
      <h2>Projects</h2>
      <ul class="project-list">
        {projects.map((project) => (
          <li>
            <ProjectPreview {...project} />
          </li>
        ))}
      </ul>
    </section>

    <section id="education" class="education">
      <h2>Education & Certifications</h2>
      <ul class="credential-list">
        {credentials.map((credential) => (
          <li>
            <CredentialPreview {...credential} />
          </li>
        ))}
      </ul>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  main {
    max-width: var(--page-max-width);
    margin: 0 auto;
    padding: 0 var(--page-padding);
  }

  .hero {
    padding: 0 0 clamp(1.5rem, 4vw, 2.5rem);
  }

  .hero-content {
    display: flex;
    flex-direction: column-reverse;
    gap: 2rem;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .hero-description {
    color: var(--color-text-muted);
    font-size: var(--font-size-base);
    line-height: 1.7;
    max-width: 30ch;
  }

  .hero-avatar {
    width: 120px;
    height: 120px;
    flex-shrink: 0;
  }

  .hero-avatar img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .projects {
    padding: 0 0 clamp(2rem, 6vw, 4rem);
    margin-bottom: 1rem;
  }

  .projects h2 {
    font-size: var(--font-size-xl);
    margin-bottom: 1rem;
  }

  .project-list {
    list-style: none;
    padding: 0;
  }

  .education {
    padding: 0 0 clamp(2rem, 6vw, 4rem);
    margin-bottom: 1rem;
  }

  .education h2 {
    font-size: var(--font-size-xl);
    margin-bottom: 1rem;
  }

  .credential-list {
    list-style: none;
    padding: 0;
  }

  @media (min-width: 640px) {
    .hero-content {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .hero-description {
      max-width: 50ch;
    }

    .hero-avatar {
      width: 180px;
      height: 180px;
    }
  }
</style>
