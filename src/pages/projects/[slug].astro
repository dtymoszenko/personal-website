---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { projects } from '../../data/projects';

export const getStaticPaths = (() => {
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      prevProject: projects[index - 1] ?? null,
      nextProject: projects[index + 1] ?? null,
    },
  }));
}) satisfies GetStaticPaths;

const { project, prevProject, nextProject } = Astro.props;
const hasSourceUrl = !!project.sourceUrl && project.sourceUrl !== '#';
const hasLiveUrl = !!project.liveUrl && project.liveUrl !== '#';
const displayUrl = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<BaseLayout
  title={`${project.name} — David Tymoszenko`}
  description={project.description}
>
  <Navigation />

  <main>
    <div class="back-to-index">
      <a href="/#projects">
        <span class="arrow">&larr;</span> Projects
      </a>
    </div>

    <article class="project-detail">
      <header>
        <h1>{project.name}</h1>
        <div class="meta">
          <span class="project-type">{project.type}</span>
          <span class="separator">/</span>
          <span class="project-stack">{project.stack.join(', ')}</span>
        </div>
      </header>

      {project.heroImage ? (
        <div class="project-image">
          <Image
            src={project.heroImage}
            alt={`${project.name} screenshot`}
            widths={[400, 800, 1200]}
            sizes="(max-width: 800px) 100vw, 800px"
            loading="eager"
            class:list={[project.heroImageDark && 'light-only']}
          />
          {project.heroImageDark && (
            <Image
              src={project.heroImageDark}
              alt={`${project.name} screenshot`}
              widths={[400, 800, 1200]}
              sizes="(max-width: 800px) 100vw, 800px"
              loading="eager"
              class="dark-only"
            />
          )}
        </div>
      ) : project.thumbnail && (
        <div class="project-image">
          <Image
            src={project.thumbnail}
            alt={`${project.name} screenshot`}
            width={800}
            height={420}
            loading="eager"
          />
        </div>
      )}

      <div class="project-body">
        {project.overview ? (
          project.overview.map((paragraph) => <p>{paragraph}</p>)
        ) : (
          <p class="placeholder">Detailed write-up coming soon.</p>
        )}
      </div>

      {project.features && (
        <section class="project-section">
          <h2>Features</h2>
          {project.features.map((feature) => (
            <figure class="feature">
              <div class="feature-image">
                <Image
                  src={feature.image}
                  alt={`${project.name} ${feature.title.toLowerCase()} screenshot`}
                  widths={[400, 800, 1200]}
                  sizes="(max-width: 800px) 100vw, 800px"
                  loading="lazy"
                  decoding="async"
                  class:list={[feature.darkImage && 'light-only']}
                />
                {feature.darkImage && (
                  <Image
                    src={feature.darkImage}
                    alt={`${project.name} ${feature.title.toLowerCase()} screenshot`}
                    widths={[400, 800, 1200]}
                    sizes="(max-width: 800px) 100vw, 800px"
                    loading="lazy"
                    decoding="async"
                    class="dark-only"
                  />
                )}
              </div>
              <figcaption>
                <h3>{feature.title}</h3>
                <p>{feature.body}</p>
              </figcaption>
            </figure>
          ))}
        </section>
      )}

      {project.build && (
        <section class="project-section project-body">
          <h2>How I built it</h2>
          {project.build.map((paragraph) => <p>{paragraph}</p>)}
        </section>
      )}

      {(project.websiteUrl || hasLiveUrl || hasSourceUrl) && (
        <ul class="project-links">
          {project.websiteUrl && (
            <li>Website: <a href={project.websiteUrl} target="_blank" rel="noopener noreferrer">{displayUrl(project.websiteUrl)}</a></li>
          )}
          {hasLiveUrl && (
            <li>Demo: <a href={project.liveUrl} target="_blank" rel="noopener noreferrer">{displayUrl(project.liveUrl!)}</a></li>
          )}
          {hasSourceUrl && (
            <li>Source code: <a href={project.sourceUrl} target="_blank" rel="noopener noreferrer">{displayUrl(project.sourceUrl!)}</a></li>
          )}
        </ul>
      )}
    </article>

    <nav class="pager" aria-label="Project navigation">
      <div class="pager-prev">
        {prevProject && (
          <a href={`/projects/${prevProject.slug}`} class="pager-link">
            <span class="arrow">&larr;</span> {prevProject.name}
          </a>
        )}
      </div>
      <div class="pager-next">
        {nextProject && (
          <a href={`/projects/${nextProject.slug}`} class="pager-link">
            {nextProject.name} <span class="arrow">&rarr;</span>
          </a>
        )}
      </div>
    </nav>
  </main>

  <Footer />
</BaseLayout>

<style>
  main {
    max-width: var(--page-max-width);
    margin: 0 auto;
    padding: 0 var(--page-padding);
  }

  .back-to-index {
    margin-bottom: 2rem;
  }

  .back-to-index a {
    display: inline-block;
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: var(--font-size-sm);
    font-weight: 500;
    transition: color 0.15s ease-out;
  }

  .back-to-index a:hover {
    color: var(--color-accent);
  }

  .back-to-index a:active {
    transform: scale(0.96);
  }

  .back-to-index .arrow {
    display: inline-block;
    transition: transform 250ms ease-out;
  }

  .back-to-index a:hover .arrow {
    transform: translateX(-0.25em);
  }

  .project-detail {
    margin-bottom: 3rem;
  }

  header {
    margin-bottom: 2rem;
  }

  header h1 {
    margin-bottom: 0.75rem;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
  }

  .project-type {
    font-weight: 600;
    color: var(--color-text);
  }

  .separator {
    color: var(--color-text-muted);
  }

  .project-stack {
    color: var(--color-text-muted);
  }

  .project-image {
    margin-bottom: 2rem;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .project-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  :global([data-theme="dark"]) .project-image {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .project-body {
    margin-bottom: 2rem;
  }

  .project-body p {
    font-size: var(--font-size-base);
    line-height: 1.75;
  }

  .project-body p + p {
    margin-top: 1.25rem;
  }

  .project-section {
    margin-top: 3.5rem;
    margin-bottom: 0;
  }

  .project-section h2 {
    margin-bottom: 1.5rem;
  }

  .feature {
    margin: 0;
  }

  .feature + .feature {
    margin-top: 3rem;
  }

  .feature-image {
    margin-bottom: 1.25rem;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  :global([data-theme="dark"]) .feature-image {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .feature-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  :global([data-theme="dark"]) :is(.project-image, .feature-image) .light-only,
  :global(:root:not([data-theme="dark"])) :is(.project-image, .feature-image) .dark-only {
    display: none;
  }

  .feature figcaption h3 {
    margin-bottom: 0.5rem;
  }

  .feature figcaption p {
    color: var(--color-text-muted);
    line-height: 1.75;
  }

  .placeholder {
    color: var(--color-text-muted);
    font-size: var(--font-size-base);
    line-height: 1.7;
    font-style: italic;
  }

  .project-links {
    margin: 3.5rem 0 2rem;
    padding: 2rem 0 0 1.25rem;
    border-top: 1px solid var(--color-border);
    line-height: 1.75;
  }

  .project-links li + li {
    margin-top: 0.25rem;
  }

  .pager {
    display: flex;
    justify-content: space-between;
    padding: 2rem 0;
    border-top: 1px solid var(--color-border);
  }

  .pager-prev {
    text-align: left;
  }

  .pager-next {
    text-align: right;
    margin-left: auto;
  }

  .pager-link {
    display: inline-block;
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: var(--font-size-sm);
    font-weight: 500;
    transition: color 0.15s ease-out;
  }

  .pager-link:hover {
    color: var(--color-accent);
  }

  .pager-link:active {
    transform: scale(0.96);
  }

  .pager-link .arrow {
    display: inline-block;
    transition: transform 250ms ease-out;
  }

  .pager-prev .pager-link:hover .arrow {
    transform: translateX(-0.25em);
  }

  .pager-next .pager-link:hover .arrow {
    transform: translateX(0.25em);
  }
</style>
