---
import Link from './Link.astro';

interface Props {
  slug: string;
  name: string;
  description: string;
  type: string;
  stack: string[];
  sourceUrl?: string;
  liveUrl?: string;
}

const { slug, name, description, type, stack, sourceUrl, liveUrl } = Astro.props;
---

<article class="project">
  <div class="project-content">
    <h3>
      <a href={`/projects/${slug}`} class="project-title-link">{name}</a>
    </h3>
    <p>{description}</p>
    <footer>
      <span class="project-type">{type}</span>
      <span class="separator">/</span>
      <span class="project-stack">{stack.join(', ')}</span>
      {sourceUrl && sourceUrl !== '#' && (
        <Link href={sourceUrl} class="project-link">Source</Link>
      )}
      {liveUrl && liveUrl !== '#' && (
        <Link href={liveUrl} class="project-link">Demo</Link>
      )}
    </footer>
  </div>
</article>

<style is:global>
  .project {
    display: flex !important;
    flex-direction: row !important;
    align-items: center;
    gap: 3rem;
    padding: 2rem 0;
  }

  .project:not(:first-child) {
    border-top: 1px solid var(--color-border);
  }

  .project-content {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    min-width: 0;
  }

  .project h3 {
    font-size: var(--font-size-lg);
    font-weight: 600;
  }

  .project p {
    color: var(--color-text-muted);
    font-size: var(--font-size-base);
    line-height: 1.7;
    max-width: 65ch;
  }

  .project footer {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-variant-numeric: tabular-nums;
  }

  .project-type {
    font-weight: 600;
    color: var(--color-text);
  }

  .separator {
    color: var(--color-text-muted);
  }

  .project-stack {
    color: var(--color-text-muted);
  }

  .project-title-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
    text-decoration-color: var(--color-accent);
    transition: color 0.15s ease-out, text-decoration-color 0.15s ease-out;
  }

  .project-title-link:hover {
    color: var(--color-accent-hover);
    text-decoration-color: var(--color-accent-hover);
  }

  .project-title-link:active {
    display: inline-block;
    transform: scale(0.98);
  }

  .project-link {
    margin-left: 0.5rem;
  }

  @media (max-width: 639px) {
    .project {
      flex-direction: column !important;
      align-items: flex-start;
      gap: 1.25rem;
    }
  }
</style>
