---
import Link from './Link.astro';
import HammerIcon from '../assets/icons/hammer.svg';

interface Props {
  name: string;
  description: string;
  type: 'Education' | 'Certification' | 'In Progress';
  url?: string;
}

const { name, description, type, url } = Astro.props;
---

<article class="credential">
  <h3>
    {url ? <Link href={url}>{name}</Link> : name}
  </h3>
  <p>{description}</p>
  <footer>
    <span class:list={['credential-type', { 'in-progress': type === 'In Progress' }]}>
      {type === 'In Progress' && (
        <span class="hammer-icon"><HammerIcon /></span>
      )}
      {type}
    </span>
  </footer>
</article>

<style>
  .credential {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem 0;
  }

  .credential:not(:first-child) {
    border-top: 1px solid var(--color-border);
  }

  h3 {
    font-size: var(--font-size-lg);
    font-weight: 600;
  }

  p {
    color: var(--color-text-muted);
    font-size: var(--font-size-base);
    line-height: 1.7;
    max-width: 65ch;
  }

  footer {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
  }

  .credential-type {
    font-weight: 600;
    color: var(--color-text);
  }

  .in-progress {
    color: var(--color-accent);
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
  }

  .hammer-icon {
    display: inline-flex;
  }

  .hammer-icon :global(svg) {
    width: 1em;
    height: 1em;
  }
</style>
