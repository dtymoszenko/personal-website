---
import EmailIcon from '../assets/icons/email.svg';
import GithubIcon from '../assets/icons/github.svg';
import LinkedinIcon from '../assets/icons/linkedin.svg';
---

<div class="social-links">
  <a href="mailto:dtymoszenko@gmail.com">
    <EmailIcon />
    <span>dtymoszenko@gmail.com</span>
  </a>
  <a
    href="https://github.com/dtymoszenko"
    target="_blank"
    rel="noopener noreferrer"
  >
    <GithubIcon />
    <span>GitHub</span>
  </a>
  <a
    href="https://www.linkedin.com/in/dtymoszenko/"
    target="_blank"
    rel="noopener noreferrer"
  >
    <LinkedinIcon />
    <span>LinkedIn</span>
  </a>
</div>

<style>
  .social-links {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  a {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-text);
    font-size: var(--font-size-sm);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.25em;
    text-decoration-thickness: 2px;
    transition: color 0.15s ease-out;
  }

  a:hover {
    color: var(--color-accent);
  }

  a :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
  }
</style>
